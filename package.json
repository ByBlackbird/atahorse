{
  "name": "atahorse",
  "private": true,
  "version": "3.0.0",
  "description": "Atahorse — kişisel okul sistemi: öğrenme bilimine dayalı, profile göre açılan kurs motoru.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c yellow,blue \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "tsx scripts/build-web.ts --watch",
    "dev:api": "tsx watch --ignore ./data server/index.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "tsx scripts/build-web.ts",
    "build:api": "tsx scripts/build-api.ts",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning dist-server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node tests/e2e.mjs",
    "db:migration": "tsx scripts/gen-migration.ts",
    "db:studio": "drizzle-kit studio",
    "ci": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@tanstack/react-query": "^5.90.2",
    "@trpc/client": "^11.6.0",
    "@trpc/react-query": "^11.6.0",
    "@trpc/server": "^11.6.0",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "three": "^0.180.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "concurrently": "^9.2.0",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.10",
    "playwright": "^1.55.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
