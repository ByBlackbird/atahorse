msgstr "With drawings, comparison tables and example visuals"

msgid "Önce durur, olası nedenleri tek tek sıralayıp analiz ederim"
msgstr "I pause first, list possible causes one by one and analyze"

msgid "Önceki gönderilerin"
msgstr "Your previous submissions"

msgid "Özgürce denemeler yapıp kendi yolumu keşfetmek isterim"
msgstr "I want to experiment freely and discover my own path"

msgid "Öğrenci Gönderileri"
msgstr "Student Submissions"

msgid "Üniversite düzeyinde ders materyali"
msgstr "University-level course materials"

msgid "İncelemede"
msgstr "Under Review"

msgid "Şeffaf Öğretim"
msgstr "Transparent Teaching"

