msgstr "At What Level?"

msgid "Başlangıç - Yeni başlıyorum"
msgstr "Beginner - Just Starting"

msgid "Orta - Biraz biliyorum, derinleşmek istiyorum"
msgstr "Intermediate - Know a bit, want to deepen"

msgid "İleri - Uzmanlaşmak istiyorum"
msgstr "Advanced - Want to become an expert"

msgid "Kursumu Oluştur"
msgstr "Create My Course"

msgid "Modüller"
msgstr "Modules"

msgid "Görevler"
msgstr "Tasks"

msgid "Önceki"
msgstr "Previous"

msgid "Sonraki"
msgstr "Next"

msgid "Kursu Tamamla"
msgstr "Complete Course"

msgid "Tebrikler! Bu kursu tamamladın."
msgstr "Congratulations! You completed this course."

msgid "Sertifikamı İndir"
msgstr "Download My Certificate"

msgid "Öğrenme Stili ve Beyin Lobu Analizi"
msgstr "Learning Style and Brain Lobe Analysis"

msgid "Sana en uygun öğrenme yöntemini belirlemek için bu kısa testi tamamla."
msgstr "Complete this short test to determine the most suitable learning method for you."

msgid "Testi Atla"
msgstr "Skip Test"

msgid "Testi Tamamla"
msgstr "Complete Test"

msgid "Atahorse - AI Destekli Kişiselleştirilmiş Eğitim Platformu"
msgstr "Atahorse - AI-Powered Personalized Education Platform"

msgid "Güvenilir kaynaklardan, kişiselleştirilmiş eğitim"
msgstr "Personalized education from reliable sources"

msgid "Tüm zorunlu alanları doldurun."
msgstr "Please fill in all required fields."

msgid "Bu kullanıcı adı veya e-posta zaten kullanılıyor."
msgstr "This username or email is already in use."

msgid "Kayıt başarılı! Şimdi giriş yapabilirsiniz."
msgstr "Registration successful! You can now sign in."

msgid "Kullanıcı adı veya şifre hatalı."
msgstr "Incorrect username or password."

msgid "Çıkış yapıldı."
msgstr "Signed out."

msgid "Lütfen önce giriş yapın."
msgstr "Please sign in first."

msgid "Öğrenme stiliniz belirlendi!"
msgstr "Your learning style has been determined!"

msgid "Test atlandı. Varsayılan ayarlar kullanılacak."
msgstr "Test skipped. Default settings will be used."

msgid "Lütfen bir konu girin."
msgstr "Please enter a topic."

msgid "AI kursunuzu oluşturuyor... Bu işlem birkaç dakika sürebilir."
msgstr "Creating your AI course... This may take a few minutes."

msgid "Kursunuz başarıyla oluşturuldu!"
msgstr "Your course has been successfully created!"

msgid "Kurs bulunamadı."
msgstr "Course not found."

msgid "Sertifika almak için kursu tamamlamanız gerekiyor."
msgstr "You need to complete the course to get a certificate."

