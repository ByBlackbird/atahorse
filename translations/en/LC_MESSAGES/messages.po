msgid "Atahorse - AI Eğitim Platformu"
msgstr "Atahorse - AI Education Platform"

msgid "Panel"
msgstr "Dashboard"

msgid "Kurs Oluştur"
msgstr "Create Course"

msgid "Çıkış"
msgstr "Logout"

msgid "Giriş"
msgstr "Login"

msgid "Kayıt Ol"
msgstr "Sign Up"

msgid "Atahorse ile Kişiselleştirilmiş Öğrenmeye Başla"
msgstr "Start Personalized Learning with Atahorse"

msgid "AI destekli, güvenilir kaynaklardan oluşturulmuş, öğrenme stiline özel eğitimler."
msgstr "AI-powered, personalized education from reliable sources tailored to your learning style."

msgid "Hemen Başla"
msgstr "Get Started"

msgid "Giriş Yap"
msgstr "Sign In"

msgid "Nasıl Çalışır?"
msgstr "How It Works?"

msgid "4 adımda kişiselleştirilmiş eğitim deneyimi"
msgstr "Personalized learning experience in 4 steps"

msgid "1. Kayıt Ol"
msgstr "1. Sign Up"

msgid "Platforma ücretsiz kaydol ve profilini oluştur."
msgstr "Sign up for free and create your profile."

msgid "2. Öğrenme Stilini Keşfet"
msgstr "2. Discover Your Learning Style"

msgid "Beyin lobu analizi ile en etkili öğrenme yöntemini belirle."
msgstr "Determine the most effective learning method through brain lobe analysis."

msgid "3. AI Kurs Oluştur"
msgstr "3. Create AI Course"

msgid "İstediğin konuyu ve seviyeyi seç, AI sana özel kurs hazırlasın."
msgstr "Choose any topic and level, let AI prepare a course just for you."

msgid "4. Sertifika Al"
msgstr "4. Get Certified"

msgid "Kursu tamamla, başarını sertifika ile taçlandır."
msgstr "Complete the course and crown your achievement with a certificate."

msgid "Atahorse'a Giriş Yap"
msgstr "Sign In to Atahorse"

msgid "Eğitim yolculuğuna devam et"
msgstr "Continue your learning journey"

msgid "Kullanıcı Adı"
msgstr "Username"

msgid "Şifre"
msgstr "Password"

msgid "Hesabın yok mu?"
msgstr "Don't have an account?"

msgid "Atahorse'a Kayıt Ol"
msgstr "Sign Up for Atahorse"

